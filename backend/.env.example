# Supabase Postgres URI (Settings → Database → Connection string → URI)
# Replace [YOUR-PASSWORD] with the password you set during project creation.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# JWT secret used by Supabase Auth to sign access tokens (Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=replace-me

# Where the React dev server runs
FRONTEND_ORIGIN=http://localhost:5173

# Optional
PORT=8080
